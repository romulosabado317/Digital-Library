{
  "name": "digital-library-operations-and-insights-management-system",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm run test -w backend",
    "test:coverage": "npm run test:coverage -w backend",
    "db:generate": "npm run prisma:generate -w backend",
    "db:migrate": "npm run prisma:migrate -w backend",
    "db:deploy": "npm run prisma:deploy -w backend",
    "db:seed": "npm run prisma:seed -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "effect": "^3.21.0",
    "fdir": "^6.5.0"
  }
}
